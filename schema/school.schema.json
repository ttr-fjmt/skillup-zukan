{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillup-zukan.net/schema/school.schema.json",
  "title": "School",
  "description": "スキルアップ図鑑に掲載する講座・スクール1件分のレコード。enum値は scraper/lib/schema.js のマスタと必ず一致させること。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "school_name",
    "description",
    "skill_genre",
    "purpose",
    "target_level",
    "career_paths",
    "price",
    "format",
    "area",
    "subsidy_eligible",
    "career_support",
    "features",
    "review_summary",
    "official_url",
    "cta_url",
    "cta_type",
    "click_tracking_id",
    "created_at",
    "updated_at",
    "status",
    "area_source",
    "plans"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "slug形式のユニークID。公式サイトのドメインから導出する（衝突時は -2, -3 のサフィックスを付与）。",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64
    },
    "school_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "サービス名。UIに表示する名称はこれを使う（詳細ページの見出し、一覧のカード、診断結果、CTA周辺のすべて）。"
    },
    "official_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "運営会社の正式名称（社内参考情報。UI表示には使用しない。表示用の名称は school_name を使用する）。ページ本文に「会社名」「商号」等として明示された表記のみを一字一句入れる。英語表記しか確認できない場合や、著作権表記からの推測しかできない場合は null（誤ると実在の法人についての誤情報になるため、取りこぼしの方を許容する）。",
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "description": "概要文（100〜200字程度）。公式サイト本文の抽出・要約であること（原文転載・創作は禁止）。",
      "minLength": 1,
      "maxLength": 400
    },
    "skill_genre": {
      "type": "array",
      "description": "GENREのいずれか、複数可。",
      "items": {
        "type": "string",
        "enum": [
          "programming",
          "webdesign",
          "uiux",
          "video_editing",
          "web_marketing",
          "genai_dx",
          "language",
          "certification"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "purpose": {
      "type": "array",
      "description": "PURPOSEのいずれか、複数可。",
      "items": {
        "type": "string",
        "enum": [
          "career_change",
          "side_job",
          "freelance",
          "current_job_skillup",
          "certification_itself",
          "hobby"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "target_level": {
      "type": "string",
      "description": "LEVELのいずれか、単一。",
      "enum": [
        "beginner",
        "novice",
        "experienced",
        "advanced"
      ]
    },
    "career_paths": {
      "type": "array",
      "description": "自由記述の職種名配列（例: \"フロントエンドエンジニア\"）。読み取れない場合は空配列。",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "uniqueItems": true
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "min_yen",
        "scope",
        "kind"
      ],
      "properties": {
        "display": {
          "type": "string",
          "description": "plans から機械生成する表示用文字列（AIに文章化させない）。プランが複数なら「475,200円〜」、1件のみなら「657,800円」、月額なら「月額39,600円〜」。金額を確認できなかった場合は「要問い合わせ」。",
          "minLength": 1,
          "maxLength": 120
        },
        "min_yen": {
          "type": [
            "integer",
            "null"
          ],
          "description": "ソート・フィルター用の最低価格（円）。plans[].amount の最小値を機械的に求めたもの。金額が取れなければ null（0で埋めない）。【注意】scope=\"detail_page\" のレコードは、巡回した1ページ内での最小値にすぎず、そのスクール全体の最安値とは限らない。ソート・フィルターでは参考値として扱うこと。",
          "minimum": 0
        },
        "scope": {
          "type": "string",
          "enum": [
            "top_page",
            "detail_page"
          ],
          "description": "金額をどこから取得したか。price_detail_url の有無から導出する。top_page=トップページのみ。detail_page=フォールバックで詳細ページを巡回した（その1ページ内の情報に限られる）。"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "total",
            "monthly",
            null
          ],
          "description": "min_yen / display がどの種別の金額かを示す。total を優先し、無ければ monthly を使う。どちらも無ければ null。価格ソートは同じ kind 同士で行うこと。"
        }
      },
      "description": "plans から導出される表示用オブジェクト。値そのものは plans が持つ。"
    },
    "format": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "both"
      ]
    },
    "area": {
      "type": "array",
      "description": "都道府県配列。format=online のみの場合は空配列。",
      "items": {
        "type": "string",
        "enum": [
          "北海道",
          "青森県",
          "岩手県",
          "宮城県",
          "秋田県",
          "山形県",
          "福島県",
          "茨城県",
          "栃木県",
          "群馬県",
          "埼玉県",
          "千葉県",
          "東京都",
          "神奈川県",
          "新潟県",
          "富山県",
          "石川県",
          "福井県",
          "山梨県",
          "長野県",
          "岐阜県",
          "静岡県",
          "愛知県",
          "三重県",
          "滋賀県",
          "京都府",
          "大阪府",
          "兵庫県",
          "奈良県",
          "和歌山県",
          "鳥取県",
          "島根県",
          "岡山県",
          "広島県",
          "山口県",
          "徳島県",
          "香川県",
          "愛媛県",
          "高知県",
          "福岡県",
          "佐賀県",
          "長崎県",
          "熊本県",
          "大分県",
          "宮崎県",
          "鹿児島県",
          "沖縄県"
        ]
      },
      "uniqueItems": true
    },
    "subsidy_eligible": {
      "type": "boolean",
      "description": "教育訓練給付金等の対象講座を持つか。公式サイトに明記が無い場合は false（不明を true にしないこと）。"
    },
    "career_support": {
      "type": "boolean"
    },
    "features": {
      "type": "array",
      "description": "特徴バレット（3〜5個目安）。公式サイト本文に実際に記載がある内容のみ。無ければ空配列。",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "maxItems": 8
    },
    "review_summary": {
      "description": "口コミ要約。未収集の場合は null。",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "sources"
          ],
          "properties": {
            "text": {
              "type": "string",
              "description": "自社の言葉による要約文。原文転載・個別口コミの言い換えは禁止。",
              "minLength": 1,
              "maxLength": 600
            },
            "sources": {
              "type": "array",
              "description": "出典。表示時は必ず出典名＋直リンクとセットで出すため、最低1件必要。",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_name",
                  "source_url",
                  "fetched_at"
                ],
                "properties": {
                  "source_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "source_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://"
                  },
                  "fetched_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "review_source_urls": {
      "type": "array",
      "description": "口コミ要約パイプラインが週次で巡回する口コミページURL。人力またはクエリで特定して保持する（掲載レコードの一部ではなく、パイプラインの入力）。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_name",
          "source_url"
        ],
        "properties": {
          "source_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        }
      }
    },
    "official_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "cta_url": {
      "type": "string",
      "description": "アフィリエイトリンク、または official_url と同一。",
      "format": "uri",
      "pattern": "^https?://"
    },
    "cta_type": {
      "type": "string",
      "enum": [
        "affiliate",
        "direct"
      ]
    },
    "click_tracking_id": {
      "type": "string",
      "description": "CTAクリック計測用のユニークID（click-{id} 形式）。",
      "pattern": "^click-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "description": "active=掲載中（二段階検証を通過した時点でここに入る） / skipped=掲載しない。",
      "enum": [
        "active",
        "skipped"
      ]
    },
    "source": {
      "type": "string",
      "description": "レコードの出所。ai-discovered=発見パイプライン、a8=A8インポート、manual=手動、mock=動作確認用のモック。",
      "enum": [
        "ai-discovered",
        "a8",
        "manual",
        "mock"
      ]
    },
    "source_note": {
      "type": "string",
      "maxLength": 200
    },
    "verified_url": {
      "type": "string",
      "description": "二段階検証で実際にHTTPアクセスできたURL（official_url と異なる場合がある）。",
      "format": "uri",
      "pattern": "^https?://"
    },
    "review_flags": {
      "type": "array",
      "description": "自動抽出の確度が低い箇所・追加で巡回した箇所の目印（社内参考情報。UI表示には使用しない）。承認フェーズを持たないため、「掲載はするが人が見た方がよい」点をここに残す。format_unconfirmed=受講形式をページ本文で確定できなかった。detail_page_crawled=フォールバックで詳細ページを1回巡回した（price_detail_url / area_detail_url を参照）。 price_scope_limited=価格が詳細ページ1枚から取得されており、他コースにより安いプランが存在しうる。 area_unconfirmed=校舎ページまで見たが、都道府県も「オンライン専用」の明記も確認できなかった。",
      "items": {
        "type": "string",
        "enum": [
          "format_unconfirmed",
          "detail_page_crawled",
          "price_scope_limited",
          "area_unconfirmed"
        ]
      },
      "uniqueItems": true
    },
    "area_source": {
      "type": "string",
      "enum": [
        "top_page",
        "detail_page"
      ],
      "description": "area をどこから取得したか。top_page=トップページのみで判断した。detail_page=フォールバックで校舎一覧・アクセスページを巡回して判断した。price.scope と同じ考え方で、確度の目安として残す（社内参考情報。UI表示には使用しない）。"
    },
    "plans": {
      "type": "array",
      "description": "ページ本文に記載されているプラン・コースの一覧。1プラン＝1期間＋1金額のセットで、price.display / price.min_yen はここから機械生成する。期間はスクール全体の代表値を持たない（「最短」を代表値にすると、キャンペーンの申込期限のような無関係な期間や、性質の違う短期集中コースの期間を掲げてしまうため）。金額・期間を確認できなかった場合は空配列。 金額は種別（kind）が異なるものを混ぜて比較しない。月額制と一括制が同じ数値軸に並ぶと、桁の違うものが同列に見えてしまうため。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "amount",
          "duration",
          "kind"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "プラン・コース名（ページ本文の表記をそのまま）。"
          },
          "amount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "そのプランの金額（円、カンマを除いた整数）。本文に記載が無ければ null。"
          },
          "duration": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 60,
            "description": "そのプランの受講期間（例: \"16週間\", \"約6ヶ月\"）。本文の表記をそのまま。記載が無ければ null。"
          },
          "kind": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "total",
              "monthly",
              "enrollment",
              null
            ],
            "description": "その金額の種別。total=一括・総額、monthly=月額、enrollment=入学金。本文の「月額」「入学金」「一括」等の表記から判定する。判定できなければ null。min_yen は同じ種別の中でのみ求める（月額と総額を比較・合算しない）。"
          }
        }
      }
    },
    "price_detail_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "料金のフォールバック巡回で参照した詳細ページのURL（社内参考情報）。price.scope の導出元。"
    },
    "area_detail_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "開催エリアのフォールバック巡回で参照した詳細ページのURL（社内参考情報）。area_source の導出元。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "format": {
            "const": "online"
          }
        },
        "required": [
          "format"
        ]
      },
      "then": {
        "properties": {
          "area": {
            "maxItems": 0
          }
        },
        "description": "format=online の場合、area は空配列でなければならない。"
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "enum": [
              "offline",
              "both"
            ]
          }
        },
        "required": [
          "format"
        ]
      },
      "then": {
        "properties": {
          "area": {
            "minItems": 1
          }
        },
        "description": "通学を含む場合、対応都道府県が最低1件必要（診断ウィザードの都道府県フィルターが機能しなくなるため）。"
      }
    }
  ]
}
